#!/usr/bin/env bash
set -e

DIR="/home/philosan/dwm/theme/rofi/"
STYLE="adaptive"
RASI="$DIR/windows.rasi"

# Grab every window: "<id> <desktop> <host> <title...>"
mapfile -t wins < <(wmctrl -l)
[[ ${#wins[@]} -eq 0 ]] && exit 0

# Show just the titles in rofi, but have rofi return the LINE INDEX
# instead of the text -- this avoids picking the wrong window if two
# windows happen to share the same title.
idx=$(printf '%s\n' "${wins[@]}" \
        | awk '{ $1=$2=$3=""; sub(/^ +/, ""); print }' \
        | rofi -dmenu -i -p -theme ${RASI} "Window" -format i)

[[ -z "$idx" ]] && exit 0

id=$(awk '{print $1}' <<< "${wins[$idx]}")

# On stock dwm this only marks the window urgent (see notes).
# With the focusonnetactive patch applied, this actually switches
# tag/monitor and focuses the window.
wmctrl -ia "$id"
